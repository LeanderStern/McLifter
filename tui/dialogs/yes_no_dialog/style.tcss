YesNoDialogScreen {
    align: center middle;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick hsl(0, 0%, 15%);
    background: hsl(0, 0%, 20%);
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
    text-style: bold;
}

Button {
    width: 100%;
}
